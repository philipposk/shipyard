# Copy of the settings this app reads. Shipyard fills the real values into .env.local for you.
# .env.local never goes to GitHub. Never put a real key in this file.

# --- Supabase (your database and sign-in) ---
# Project address. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# The "publishable" (or legacy "anon") key. Safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "secret" (or legacy "service_role") key. Server only: it bypasses every privacy rule.
# Never add NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=

# --- This app ---
# The public address of the app. Use http://localhost:3000 while building.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = installable on phones (home screen icon, works offline for the shell).
NEXT_PUBLIC_ENABLE_PWA=true
# true = show "Continue with Google". Needs a Google sign-in client set up for this app first, and real email
# confirmation. In "starter" sign-up mode (below), email sign-up is switched off while this is true.
NEXT_PUBLIC_GOOGLE_SIGNIN_ENABLED=false
# How people sign up. "starter" = no email needed, the email is not checked (fine for testing).
# "verified" = people must open a confirmation link we email them. Switch to "verified" once email sending works
# (the launch skill sets it up), then redeploy: the value is baked into the build.
NEXT_PUBLIC_SIGNUP_MODE=starter
# The email address people can write to. Shown on the privacy and terms pages. It is public on purpose.
NEXT_PUBLIC_CONTACT_EMAIL=
# true = hide the app from search engines (a private app for you and friends).
NEXT_PUBLIC_SITE_PRIVATE=false
# The email of the person who runs the app. Nobody can sign up with this email; Shipyard makes the owner
# account for you (node make-owner.mjs). Admin rights come from the database flag, never from this email.
ADMIN_EMAIL=

# --- Email (optional until you launch) ---
# Used for "forgot password" and other emails the app sends. Without these, the forgot-password button says it is not set up yet.
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
RESEND_FROM=

# --- AI (optional, only if this app calls an AI model) ---
OPENROUTER_API_KEY=
