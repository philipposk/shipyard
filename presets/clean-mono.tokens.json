  },
  "dark": {
    "background": "#0a0a0b",
    "foreground": "#f2f2f3",
    "card": "#141416",
    "muted": "#a0a0a9",
    "line": "#26262b",
    "lineStrong": "#3c3c43",
    "accent": "#f2f2f3",
    "accentContrast": "#0a0a0b",
    "focus": "#f2f2f3",
    "danger": "#f0746b",
    "dangerContrast": "#0a0a0b"
