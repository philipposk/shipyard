{
  "id": "clean-mono",
  "name": "Clean monochrome",
  "description": "Near-black on white, a menu on the left, flat panels, sharp capital-letter buttons and tight type. No colour to get in the way.",
  "goodFor": "tools, dashboards, SaaS, anything with lots of data",
  "defaultTheme": "light",
  "font": {
    "body": "Inter",
    "heading": "same"
  },
  "radius": {
    "base": 8,
    "sm": 6
  },
  "shadow": "crisp",
  "type": {
    "scale": "compact",
    "headingWeight": 600,
    "headingTracking": "tight"
  },
  "layout": {
    "nav": "sidebar",
    "density": "compact",
